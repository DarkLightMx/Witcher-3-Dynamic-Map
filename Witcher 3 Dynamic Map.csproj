<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Witcher_3_Dynamic_Map</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- The place icons are copied next to the exe as Data\Icons. The map tiles (Data\Maps) are not copied
         on build; build-release.ps1 adds them to the release package. -->
    <Content Include="Data\Icons\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
